# LLM provider credentials. At least one model provider is required.
DEEPSEEK_API_KEY=your_deepseek_api_key

# Optional Claude provider for master/subagents.
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Feishu/Lark app credentials. One master app is enough for normal use.
LARK_APP_ID_MASTER=your_master_lark_app_id
LARK_APP_SECRET_MASTER=your_master_lark_app_secret
